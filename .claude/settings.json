{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/density-chain/wiki_check.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the density-trellis"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/density-chain/wiki_check.mjs\" --hook",
            "timeout": 30,
            "statusMessage": "Checking the density-trellis"
          }
        ]
      }
    ]
  }
}
