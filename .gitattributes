*.sh text eol=lf
# The probe corpus must stay byte-stable on every platform: no eol
# conversion (core.autocrlf would rewrite LF to CRLF on Windows checkouts
# and silently move every ground-truth answer).
data/frankenstein.txt -text
data/synthetic_chronicle.txt -text
# Support-oracle fixtures are SHA-256-pinned by their own manifest; eol
# conversion on Windows checkouts rewrites the bytes and the drill
# correctly REFUSES (observed July 16, 2026 — same hazard as above).
fixtures/support_oracle/*.json -text
# Judge-panel fixtures carry the same manifest-pin/eol hazard.
fixtures/judge_panel/*.json -text
# Judge-intake fixtures carry the same manifest-pin/eol hazard.
fixtures/judge_intake/*.json -text
# Judge-convocation fixtures carry the same manifest-pin/eol hazard.
fixtures/judge_convocation/*.json -text
# Doubts-workspace fact-base is a ground-truth discrimination corpus (same
# class as the probe corpora above): eol conversion would silently move the
# bytes the admission test reasons over. Protect it before any future pin.
fixtures/doubts_workspace/*.md -text
# Benchmark drill outputs are preserved evidence; keep their bytes stable
# when moving between Windows and Unix checkouts.
docs/benchmarks/artifacts/*.json -text -diff
# The density-trellis checker is plain ESM loaded by vitest through vite's
# transform. A CRLF checkout makes that import fail with a bare
# `SyntaxError: Invalid or unexpected token` and no stack (observed July 22,
# 2026 on a Windows rebase). Linux CI checks the file out as LF and never sees
# it, so the breakage is Windows-only and invisible to the offline job — pin
# the endings rather than rely on the platform.
tools/density-chain/*.mjs text eol=lf
