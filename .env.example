# Local development defaults. Never commit real credentials.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=trellis_user
PG_PASSWORD=trellis_password
PG_DATABASE=trellis_db

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trellis_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QUEUE_COMPLETED_RETENTION_SECONDS=3600
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=5000

PORT=3000
# Required for any non-local deployment. Replace this development placeholder.
API_KEY=replace-with-a-long-random-api-key

# Structured logging: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# `service` field stamped on every log line. Compose overrides this per
# container (api / workers); set it only for bare-host runs.
TRELLIS_SERVICE=trellis
# Worker-process Prometheus listener. Internal only: Compose never
# publishes this port to the host. The API serves authenticated /metrics
# on its own port instead.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=0.0.0.0
RLM_MAX_CONCURRENT_STREAMS=4
RLM_QUEUE_MAX_DEPTH=32
INGEST_MAX_BODY_MB=5
INGEST_MAX_UPLOAD_MB=25
EXTRACTION_MODEL=gpt-5.4-2026-03-05

# Entity resolution (Session 5). SAME_AS edges below the confidence floor
# are stored but never expand /retrieve; the sweep cap bounds adjudication
# spend per resolve:sweep run; the batch size is pairs per LLM completion.
RESOLUTION_MIN_CONFIDENCE=0.8
RESOLUTION_MAX_PAIRS_PER_SWEEP=200
RESOLUTION_BATCH_SIZE=25

# A2A server surface (Session 11). Off by default: with the flag unset
# the API exposes no A2A routes. When enabling for a non-local
# deployment, set A2A_AGENT_URL to the externally reachable JSON-RPC
# endpoint advertised in the Agent Card.
TRELLIS_A2A_ENABLED=false
#A2A_AGENT_NAME=Trellis Engine
#A2A_AGENT_URL=https://your-host/a2a/v1
#A2A_TASK_TTL_SECONDS=3600

# Use python3 on Unix-like hosts if `python` is unavailable.
PYTHON_EXECUTABLE=python
PYTHONPATH=

# Required to run LLM workers in any environment. Leave unset for zero-LLM tests.
OPENAI_API_KEY=
