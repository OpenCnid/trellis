# Local development defaults. Never commit real credentials.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=trellis_user
PG_PASSWORD=trellis_password
PG_DATABASE=trellis_db

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trellis_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QUEUE_COMPLETED_RETENTION_SECONDS=3600
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=5000

PORT=3000
# Required for any non-local deployment. Replace this development placeholder.
API_KEY=replace-with-a-long-random-api-key

# Structured logging: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# `service` field stamped on every log line. Compose overrides this per
# container (api / workers); set it only for bare-host runs.
TRELLIS_SERVICE=trellis
# Worker-process Prometheus listener. Internal only: Compose never
# publishes this port to the host. The API serves authenticated /metrics
# on its own port instead.
WORKER_METRICS_PORT=9464
WORKER_METRICS_HOST=0.0.0.0
RLM_MAX_CONCURRENT_STREAMS=4
RLM_QUEUE_MAX_DEPTH=32

# Agentic goal-loop bounds. Every goal and task is hard-bounded; exceeding a
# bound produces a typed failure rather than an unbounded loop.
AGENT_MAX_ITERATIONS_PER_GOAL=4
AGENT_MAX_TASKS_PER_GOAL=8
AGENT_MAX_CONCURRENT_TASKS=2
AGENT_TASK_MAX_ITERATIONS=5
AGENT_MAX_CONCURRENT_GOALS=2
AGENT_QUEUE_MAX_DEPTH=8
# Zero-LLM drill switch. Keep false outside explicit oracle rehearsals.
AGENT_ORACLE_ENABLED=false

INGEST_MAX_BODY_MB=5
INGEST_MAX_UPLOAD_MB=25
EXTRACTION_MODEL=gpt-5.4-2026-03-05

# Entity resolution (Session 5). SAME_AS edges below the confidence floor
# are stored but never expand /retrieve; the sweep cap bounds adjudication
# spend per resolve:sweep run; the batch size is pairs per LLM completion.
RESOLUTION_MIN_CONFIDENCE=0.8
RESOLUTION_MAX_PAIRS_PER_SWEEP=200
RESOLUTION_BATCH_SIZE=25

# Sampled citation-entailment sweep. These bound selection and paid judge
# completions; running a sweep remains a separate operator action.
ENTAILMENT_SAMPLE_RATE=0.1
ENTAILMENT_JUDGE_BUDGET_PER_SWEEP=25

# Judge-convocation support sweep. No live judge run is implied by exposing the
# validated defaults here; its operator and governance gates remain in force.
SUPPORT_SAMPLE_RATE=0.1
SUPPORT_JUDGE_BUDGET_PER_SWEEP=25
SUPPORT_VERDICT_WEIGHT=1

# Optional RLM retrieval budget. Unset uses the Python kernel default of 64;
# when set, the validated range is 1..1024.
#TRELLIS_RETRIEVAL_BUDGET_PER_RUN=64

# Root-model backend seam. These keys are validated but not yet consumed by the
# worker/root-agent path; leave them unset until that implementation lands.
#TRELLIS_RLM_BACKEND=openai
#TRELLIS_RLM_MODEL=gpt-5.4-2026-03-05
#TRELLIS_RLM_BASE_URL=https://api.openai.com/v1
#TRELLIS_RLM_API_KEY_ENV=OPENAI_API_KEY

# A2A server surface (Session 11). Off by default: with the flag unset
# the API exposes no A2A routes. When enabling for a non-local
# deployment, set A2A_AGENT_URL to the externally reachable JSON-RPC
# endpoint advertised in the Agent Card.
TRELLIS_A2A_ENABLED=false
#A2A_AGENT_NAME=Trellis Engine
#A2A_AGENT_DESCRIPTION=Provenance-enforced Recursive Language Model runtime
#A2A_AGENT_URL=https://your-host/a2a/v1
#A2A_TASK_TTL_SECONDS=3600

# External MCP tool servers for the RLM sub-agent (Sessions 10/12).
# Unset means no external tools. transport "stdio" (default) spawns the
# configured argument vector; "http" dials a Streamable HTTP server —
# https required for public hosts. Credentials are REFERENCES: auth
# names an env var (valueEnv); the value lives in that variable, set on
# the worker process, and never in this registry. A registry naming an
# unset variable fails startup on purpose.
#TRELLIS_MCP_SERVERS='[{"transport":"http","name":"hosted","url":"https://tools.example.com/mcp","tools":["web_search"],"auth":{"kind":"bearer","valueEnv":"HOSTED_MCP_TOKEN"}}]'
#HOSTED_MCP_TOKEN=replace-with-the-real-credential

# Module registry selection for the RLM sub-agent (Session 15). Unset
# loads the default selection (module #0, spatial-flywheel) and the
# composed prompt is byte-identical to the pre-Session-15 monolith; a
# JSON array selects exactly those registered modules (max 4); [] loads
# none. Modules live under modules/<name>/ in this repository.
#TRELLIS_MODULES='["spatial-flywheel"]'

# Tier-3 workspace bounds for the RLM sub-agent (Session 14). The
# workspace is active only for runs with MCP servers configured or a
# goal id; over-budget writes raise in the REPL (hard caps 1024
# segments / 32 MiB).
TRELLIS_WORKSPACE_MAX_SEGMENTS=128
TRELLIS_WORKSPACE_MAX_BYTES=4194304

# Code-mediated editing toolkit for the RLM sub-agent (Session 20;
# docs/architecture/CODE_MEDIATED_TEXT.md). TRELLIS_EDIT_ROOT is the
# operator-owned enablement switch AND the containment boundary: set it
# to an existing directory (e.g. a branch checkout) and the RLM gains
# `trellis_textedit` — locate-by-query addressing, staged splices, and
# hash-guarded atomic write_back — strictly inside that directory.
# Unset (the default) injects nothing and the RLM prompt is
# byte-identical. Bounds are hard-capped (32 MiB per file / 64 frames);
# landing edits stays a human PR — the toolkit never touches git.
#TRELLIS_EDIT_ROOT=/path/to/a/branch/checkout
#TRELLIS_TEXTEDIT_MAX_FILE_BYTES=4194304
#TRELLIS_TEXTEDIT_MAX_FILES=16

# Workspace lineage parking (Session 16). End-of-run workspace snapshots
# from goal tasks are parked in Redis so later tasks in the SAME goal
# can be seeded from them: age-bounded (TTL, hard cap 24 h — a parked
# snapshot is a checkpoint, never durable memory) and volume-bounded per
# goal (hard cap 64 MiB).
#SCRATCH_TTL_SECONDS=3600
#SCRATCH_MAX_BYTES_PER_GOAL=8388608

# Use python3 on Unix-like hosts if `python` is unavailable.
PYTHON_EXECUTABLE=python
PYTHONPATH=

# Required to run LLM workers in any environment. Leave unset for zero-LLM tests.
OPENAI_API_KEY=
