# Local development defaults. Never commit real credentials.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=trellis_user
PG_PASSWORD=trellis_password
PG_DATABASE=trellis_db

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trellis_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

QUEUE_COMPLETED_RETENTION_SECONDS=3600
QUEUE_COMPLETED_RETENTION_COUNT=1000
QUEUE_FAILED_RETENTION_SECONDS=604800
QUEUE_FAILED_RETENTION_COUNT=5000

PORT=3000
# Required for any non-local deployment. Replace this development placeholder.
API_KEY=replace-with-a-long-random-api-key
RLM_MAX_CONCURRENT_STREAMS=4
RLM_QUEUE_MAX_DEPTH=32
INGEST_MAX_BODY_MB=5
INGEST_MAX_UPLOAD_MB=25
EXTRACTION_MODEL=gpt-5.4-2026-03-05

# Use python3 on Unix-like hosts if `python` is unavailable.
PYTHON_EXECUTABLE=python
PYTHONPATH=

# Required to run LLM workers in any environment. Leave unset for zero-LLM tests.
OPENAI_API_KEY=
