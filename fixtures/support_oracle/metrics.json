    { "name": "planted-all-clean", "expectClass": "all_clean", "expr": { "op": "all", "children": [ { "op": "leaf", "opId": "op:always-clean" } ] } },
    { "name": "planted-all-abstain", "expectClass": "all_abstain", "expr": { "op": "leaf", "opId": "op:never-opines" } }
  ]
}
