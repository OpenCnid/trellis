    { "op:grounding": "drawback", "op:coherence": "clean", "op:always-drawback": "drawback", "op:always-clean": "clean" },
    { "op:grounding": "clean", "op:coherence": "clean", "op:always-drawback": "drawback", "op:always-clean": "clean" },
    { "op:grounding": "drawback", "op:coherence": "drawback", "op:always-drawback": "drawback", "op:always-clean": "clean" }
  ],
  "validCandidates": [
    { "name": "any-of-two", "expr": { "op": "any", "children": [ { "op": "leaf", "opId": "op:grounding" }, { "op": "leaf", "opId": "op:coherence" } ] } },
    { "name": "all-of-two", "expr": { "op": "all", "children": [ { "op": "leaf", "opId": "op:grounding" }, { "op": "leaf", "opId": "op:coherence" } ] } },
    { "name": "two-of-three", "expr": { "op": "kofk", "k": 2, "children": [ { "op": "leaf", "opId": "op:grounding" }, { "op": "leaf", "opId": "op:coherence" }, { "op": "leaf", "opId": "op:always-drawback" } ] } }
